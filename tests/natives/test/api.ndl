
namespace global {

    // Primitives pass
    boolean passVoid();
    boolean passChar(char arg);
    boolean passBoolean(boolean arg);
    boolean passByte(byte arg);
    boolean passShort(short arg);
    boolean passInt(int arg);
    boolean passLong(long arg);
    boolean passFloat(float arg);
    boolean passDouble(double arg);
    boolean passString(string arg);

    // Primitives: return
    void returnVoid();
    char returnChar();
    boolean returnBoolean();
    byte returnByte();
    short returnShort();
    int returnInt();
    long returnLong();
    float returnFloat();
    double returnDouble();
    string returnStringLiteral();
    [Dealloc] string returnString();

    // Primitives: ping
    char pingChar(char arg);
    boolean pingBoolean(boolean arg);
    byte pingByte(byte arg);
    short pingShort(short arg);
    int pingInt(int arg);
    long pingLong(long arg);
    float pingFloat(float arg);
    double pingDouble(double arg);
    [Dealloc] string pingString(string arg);

    // Primitives: callback arg
    void callbackVoid(VoidCallback arg);
    boolean callbackArgChar(CallbackPassChar arg);
    boolean callbackArgBoolean(CallbackPassBoolean arg);
    boolean callbackArgByte(CallbackPassByte arg);
    boolean callbackArgShort(CallbackPassShort arg);
    boolean callbackArgInt(CallbackPassInt arg);
    boolean callbackArgLong(CallbackPassLong arg);
    boolean callbackArgFloat(CallbackPassFloat arg);
    boolean callbackArgDouble(CallbackPassDouble arg);
    boolean callbackArgString(CallbackPassString arg);
    boolean callbackArgCallback(VoidCallback pass, CallbackPassCallback arg);

    // Primitives: callback return
    boolean callbackReturnChar(CallbackReturnChar arg);
    boolean callbackReturnBoolean(CallbackReturnBoolean arg);
    boolean callbackReturnByte(CallbackReturnByte arg);
    boolean callbackReturnShort(CallbackReturnShort arg);
    boolean callbackReturnInt(CallbackReturnInt arg);
    boolean callbackReturnLong(CallbackReturnLong arg);
    boolean callbackReturnFloat(CallbackReturnFloat arg);
    boolean callbackReturnDouble(CallbackReturnDouble arg);
    boolean callbackReturnString(CallbackReturnString arg);
    VoidCallback callbackReturnCallback(CallbackReturnCallback arg);

    // Arrays: pass
    boolean passCharArray(Array<char> arg);
    boolean passBooleanArray(Array<boolean> arg);
    boolean passByteArray(Array<byte> arg);
    boolean passShortArray(Array<short> arg);
    boolean passIntArray(Array<int> arg);
    boolean passLongArray(Array<long> arg);
    boolean passFloatArray(Array<float> arg);
    boolean passDoubleArray(Array<double> arg);

    // Arrays: return
    [Dealloc] Array<char> returnCharArray();
    [Dealloc] Array<boolean> returnBooleanArray();
    [Dealloc] Array<byte> returnByteArray();
    [Dealloc] Array<short> returnShortArray();
    [Dealloc] Array<int> returnIntArray();
    [Dealloc] Array<long> returnLongArray();
    [Dealloc] Array<float> returnFloatArray();
    [Dealloc] Array<double> returnDoubleArray();

    // Arrays: ping
    Array<char> pingCharArray(Array<char> arg);
    Array<boolean> pingBooleanArray(Array<boolean> arg);
    Array<byte> pingByteArray(Array<byte> arg);
    Array<short> pingShortArray(Array<short> arg);
