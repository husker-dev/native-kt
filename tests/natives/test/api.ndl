    // JVMCI
    [Critical] boolean jvmci1();
    [Critical] boolean jvmci2(int a1);
    [Critical] boolean jvmci3(int a1, int a2);
    [Critical] boolean jvmci4(int a1, int a2, int a3, int a4, int a5, int a6, int a7, int a8, int a9);
    [Critical] boolean jvmci5(int a1, long a2, int a3, long a4, int a5, long a6, int a7, int a8, long a9);
    [Critical] boolean jvmci6(float a1, float a2, float a3, float a4, float a5, float a6, float a7, float a8, float a9, int a10, int a11, int a12, int a13);
    [Critical] boolean jvmci7(float a1, double a2, float a3, double a4, float a5, double a6, float a7, float a8, double a9);
    [Critical] boolean jvmci8(int a1, double a2, float a3, long a4);
    [Critical] boolean jvmci9(int a1, double a2, float a3, long a4, long a5, double a6, float a7, float a8, int a9);
    [Critical] boolean jvmci10(string a1, double a2, float a3, long a4, long a5, double a6, string a7, float a8, int a9);
    [Critical] boolean jvmci11(float a1, int a2, float a3, int a4, float a5, int a6, float a7, int a8, float a9, int a10, float a11, int a12, float a13, int a14, float a15, int a16, float a17);
    [Critical] int jvmci12();
    [Critical] long jvmci13();
    [Critical] float jvmci14();
    [Critical] double jvmci15();
    [Critical] boolean jvmciArray(Array<int> array);
    [Critical] boolean jvmciSomeArrays(Array<int> array1, Array<float> array2, Array<double> array3);
};

callback VoidCallback = void ();

// primitives

callback CallbackPassChar = boolean (char arg);
callback CallbackPassBoolean = boolean (boolean arg);
callback CallbackPassByte = boolean (byte arg);
callback CallbackPassShort = boolean (short arg);
callback CallbackPassInt = boolean (int arg);
callback CallbackPassLong = boolean (long arg);
callback CallbackPassFloat = boolean (float arg);
callback CallbackPassDouble = boolean (double arg);
callback CallbackPassString = boolean (string arg);
callback CallbackPassCallback = boolean (VoidCallback arg);

callback CallbackReturnChar = char ();
callback CallbackReturnBoolean = boolean ();
callback CallbackReturnByte = byte ();
callback CallbackReturnShort = short ();
callback CallbackReturnInt = int ();
callback CallbackReturnLong = long ();
callback CallbackReturnFloat = float ();
callback CallbackReturnDouble = double ();
callback CallbackReturnString = string ();
callback CallbackReturnCallback = VoidCallback ();

// arrays

callback CallbackPassCharArray = boolean (Array<char> arg);
callback CallbackPassBooleanArray = boolean (Array<boolean> arg);
callback CallbackPassByteArray = boolean (Array<byte> arg);
callback CallbackPassShortArray = boolean (Array<short> arg);
callback CallbackPassIntArray = boolean (Array<int> arg);
callback CallbackPassLongArray = boolean (Array<long> arg);
callback CallbackPassFloatArray = boolean (Array<float> arg);
callback CallbackPassDoubleArray = boolean (Array<double> arg);

callback CallbackReturnCharArray = Array<char> ();
callback CallbackReturnBooleanArray = Array<boolean> ();
callback CallbackReturnByteArray = Array<byte> ();
callback CallbackReturnShortArray = Array<short> ();
callback CallbackReturnIntArray = Array<int> ();
callback CallbackReturnLongArray = Array<long> ();
callback CallbackReturnFloatArray = Array<float> ();
callback CallbackReturnDoubleArray = Array<double> ();