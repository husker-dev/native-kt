interface MyInterface {
    constructor();
    [critical, name=new_critical] constructor(i32 a);
    bool test();
    [critical] bool test_critical();
    [critical] void pass_interface(MyInterface a1);
    [critical] MyInterface return_interface();
    void snake_case();
};