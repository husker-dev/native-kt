
namespace global {

    // Primitives pass
    boolean passVoid();
    boolean passChar(char arg);
    boolean passBoolean(boolean arg);
    boolean passByte(byte arg);
    boolean passShort(short arg);
    boolean passInt(int arg);
    boolean passLong(long arg);
    boolean passFloat(float arg);
    boolean passDouble(double arg);
    boolean passString(string arg);
    boolean passEnum(MyEnum arg);
    boolean passDictionary(MyDictionary arg);

    // Primitives: return
    void returnVoid();
    char returnChar();
    boolean returnBoolean();
    byte returnByte();
    short returnShort();
    int returnInt();
    long returnLong();
    float returnFloat();
    double returnDouble();
    [Dealloc] string returnString();
    MyEnum returnEnum();
    MyDictionary returnDictionary();

    // Primitives: ping
    char pingChar(char arg);
    boolean pingBoolean(boolean arg);
    byte pingByte(byte arg);
    short pingShort(short arg);
    int pingInt(int arg);
    long pingLong(long arg);
    float pingFloat(float arg);
    double pingDouble(double arg);
    [Dealloc] string pingString(string arg);
    MyEnum pingEnum(MyEnum arg);
    MyDictionary pingDictionary(MyDictionary arg);

    // Primitives: callback arg
    void callbackVoid(VoidCallback arg);
    boolean callbackArgChar(CallbackPassChar arg);
    boolean callbackArgBoolean(CallbackPassBoolean arg);
    boolean callbackArgByte(CallbackPassByte arg);
    boolean callbackArgShort(CallbackPassShort arg);
    boolean callbackArgInt(CallbackPassInt arg);
    boolean callbackArgLong(CallbackPassLong arg);
    boolean callbackArgFloat(CallbackPassFloat arg);
    boolean callbackArgDouble(CallbackPassDouble arg);
    boolean callbackArgString(CallbackPassString arg);
    boolean callbackArgCallback(VoidCallback pass, CallbackPassCallback arg);
    boolean callbackArgEnum(CallbackPassEnum arg);
    boolean callbackArgDictionary(CallbackPassDictionary arg);

    // Primitives: callback return
    boolean callbackReturnChar(CallbackReturnChar arg);
    boolean callbackReturnBoolean(CallbackReturnBoolean arg);
    boolean callbackReturnByte(CallbackReturnByte arg);
    boolean callbackReturnShort(CallbackReturnShort arg);
    boolean callbackReturnInt(CallbackReturnInt arg);
    boolean callbackReturnLong(CallbackReturnLong arg);
    boolean callbackReturnFloat(CallbackReturnFloat arg);
    boolean callbackReturnDouble(CallbackReturnDouble arg);
    boolean callbackReturnString(CallbackReturnString arg);
    VoidCallback callbackReturnCallback(CallbackReturnCallback arg);
    boolean callbackReturnEnum(CallbackReturnEnum arg);
    boolean callbackReturnDictionary(CallbackReturnDictionary arg);

    // Arrays: pass
    boolean passCharArray(Array<char> arg);
    boolean passBooleanArray(Array<boolean> arg);
    boolean passByteArray(Array<byte> arg);
    boolean passShortArray(Array<short> arg);
    boolean passIntArray(Array<int> arg);
    boolean passLongArray(Array<long> arg);
    boolean passFloatArray(Array<float> arg);
    boolean passDoubleArray(Array<double> arg);
    boolean passEnumArray(Array<MyEnum> arg);
    boolean passDictionaryArray(Array<MyDictionary> arg);

    // Arrays: return
    [Dealloc] Array<char> returnCharArray();
    [Dealloc] Array<boolean> returnBooleanArray();
    [Dealloc] Array<byte> returnByteArray();
    [Dealloc] Array<short> returnShortArray();
    [Dealloc] Array<int> returnIntArray();
    [Dealloc] Array<long> returnLongArray();
    [Dealloc] Array<float> returnFloatArray();
    [Dealloc] Array<double> returnDoubleArray();
    [Dealloc] Array<MyEnum> returnEnumArray();
    [Dealloc, DeallocContent] Array<MyDictionary> returnDictionaryArray();

    // Arrays: ping
    Array<char> pingCharArray(Array<char> arg);
    Array<boolean> pingBooleanArray(Array<boolean> arg);
    Array<byte> pingByteArray(Array<byte> arg);
    Array<short> pingShortArray(Array<short> arg);
    Array<int> pingIntArray(Array<int> arg);
    Array<long> pingLongArray(Array<long> arg);
    Array<float> pingFloatArray(Array<float> arg);
    Array<double> pingDoubleArray(Array<double> arg);
    Array<MyEnum> pingEnumArray(Array<MyEnum> arg);
    Array<MyDictionary> pingDictionaryArray(Array<MyDictionary> arg);

     // Arrays: callback arg
    boolean callbackArgCharArray(CallbackPassCharArray arg);
    boolean callbackArgBooleanArray(CallbackPassBooleanArray arg);
    boolean callbackArgByteArray(CallbackPassByteArray arg);
    boolean callbackArgShortArray(CallbackPassShortArray arg);
    boolean callbackArgIntArray(CallbackPassIntArray arg);
    boolean callbackArgLongArray(CallbackPassLongArray arg);
    boolean callbackArgFloatArray(CallbackPassFloatArray arg);
    boolean callbackArgDoubleArray(CallbackPassDoubleArray arg);
    boolean callbackArgEnumArray(CallbackPassEnumArray arg);
    boolean callbackArgDictionaryArray(CallbackPassDictionaryArray arg);

    // Arrays: callback arg
    boolean callbackReturnCharArray(CallbackReturnCharArray arg);
    boolean callbackReturnBooleanArray(CallbackReturnBooleanArray arg);
    boolean callbackReturnByteArray(CallbackReturnByteArray arg);
    boolean callbackReturnShortArray(CallbackReturnShortArray arg);
    boolean callbackReturnIntArray(CallbackReturnIntArray arg);
    boolean callbackReturnLongArray(CallbackReturnLongArray arg);
    boolean callbackReturnFloatArray(CallbackReturnFloatArray arg);
    boolean callbackReturnDoubleArray(CallbackReturnDoubleArray arg);
    boolean callbackReturnEnumArray(CallbackReturnEnumArray arg);
    boolean callbackReturnDictionaryArray(CallbackReturnDictionaryArray arg);

    // Dictionary
    boolean passBigDictionary(TypeDictionary arg);
    [Dealloc] TypeDictionary returnBigDictionary(VoidCallback callback);
    [Dealloc] TypeDictionary pingBigDictionary(TypeDictionary arg);

    // Critical
    [Critical] boolean criticalPrimitives(char a1, boolean a2, byte a3, short a4, int a5, long a6, float a7, double a8);
    [Critical] boolean criticalEnum(MyEnum a1);
    [Critical] boolean criticalString(string a1);

    [Critical] boolean criticalPrimitivesArray(Array<char> a1, Array<boolean> a2, Array<byte> a3, Array<short> a4, Array<int> a5, Array<long> a6, Array<float> a7, Array<double> a8);
    [Critical] boolean criticalEnumArray(Array<MyEnum> a1);

    [Critical] char criticalReturnChar();
    [Critical] boolean criticalReturnBoolean();
    [Critical] byte criticalReturnByte();
    [Critical] short criticalReturnShort();
    [Critical] int criticalReturnInt();
    [Critical] long criticalReturnLong();
    [Critical] float criticalReturnFloat();
    [Critical] double criticalReturnDouble();
    [Critical] MyEnum criticalReturnEnum();

    // JVMCI
    [Critical] boolean jvmci1();
    [Critical] boolean jvmci2(int a1);
    [Critical] boolean jvmci3(int a1, int a2);
    [Critical] boolean jvmci4(int a1, int a2, int a3, int a4, int a5, int a6, int a7, int a8, int a9);
    [Critical] boolean jvmci5(int a1, long a2, int a3, long a4, int a5, long a6, int a7, int a8, long a9);
    [Critical] boolean jvmci6(float a1, float a2, float a3, float a4, float a5, float a6, float a7, float a8, float a9, int a10, int a11, int a12, int a13);
    [Critical] boolean jvmci7(float a1, double a2, float a3, double a4, float a5, double a6, float a7, float a8, double a9);
    [Critical] boolean jvmci8(int a1, double a2, float a3, long a4);
    [Critical] boolean jvmci9(int a1, double a2, float a3, long a4, long a5, double a6, float a7, float a8, int a9);
    [Critical] boolean jvmci10(string a1, double a2, float a3, long a4, long a5, double a6, string a7, float a8, int a9);
    [Critical] boolean jvmci11(float a1, int a2, float a3, int a4, float a5, int a6, float a7, int a8, float a9, int a10, float a11, int a12, float a13, int a14, float a15, int a16, float a17);
    [Critical] int jvmci12();
    [Critical] long jvmci13();
    [Critical] float jvmci14();
    [Critical] double jvmci15();
    [Critical] boolean jvmciArray(Array<int> array);
    [Critical] boolean jvmciSomeArrays(Array<int> array1, Array<float> array2, Array<double> array3);
    [Critical] boolean jvmciEnum(MyEnum enum1, MyEnum enum2, Array<MyEnum> enumArray);
};

callback VoidCallback = void ();

// primitives

callback CallbackPassChar = boolean (char arg);
callback CallbackPassBoolean = boolean (boolean arg);
callback CallbackPassByte = boolean (byte arg);
callback CallbackPassShort = boolean (short arg);
callback CallbackPassInt = boolean (int arg);
callback CallbackPassLong = boolean (long arg);
callback CallbackPassFloat = boolean (float arg);
callback CallbackPassDouble = boolean (double arg);
callback CallbackPassString = boolean (string arg);
callback CallbackPassCallback = boolean (VoidCallback arg);
callback CallbackPassEnum = boolean (MyEnum arg);
callback CallbackPassDictionary = boolean (MyDictionary arg);

callback CallbackReturnChar = char ();
callback CallbackReturnBoolean = boolean ();
callback CallbackReturnByte = byte ();
callback CallbackReturnShort = short ();
callback CallbackReturnInt = int ();
callback CallbackReturnLong = long ();
callback CallbackReturnFloat = float ();
callback CallbackReturnDouble = double ();
callback CallbackReturnString = string ();
callback CallbackReturnCallback = VoidCallback ();
callback CallbackReturnEnum = MyEnum ();
callback CallbackReturnDictionary = MyDictionary ();

// arrays

callback CallbackPassCharArray = boolean (Array<char> arg);
callback CallbackPassBooleanArray = boolean (Array<boolean> arg);
callback CallbackPassByteArray = boolean (Array<byte> arg);
callback CallbackPassShortArray = boolean (Array<short> arg);
callback CallbackPassIntArray = boolean (Array<int> arg);
callback CallbackPassLongArray = boolean (Array<long> arg);
callback CallbackPassFloatArray = boolean (Array<float> arg);
callback CallbackPassDoubleArray = boolean (Array<double> arg);
callback CallbackPassEnumArray = boolean (Array<MyEnum> arg);
callback CallbackPassDictionaryArray = boolean (Array<MyDictionary> arg);

callback CallbackReturnCharArray = Array<char> ();
callback CallbackReturnBooleanArray = Array<boolean> ();
callback CallbackReturnByteArray = Array<byte> ();
callback CallbackReturnShortArray = Array<short> ();
callback CallbackReturnIntArray = Array<int> ();
callback CallbackReturnLongArray = Array<long> ();
callback CallbackReturnFloatArray = Array<float> ();
callback CallbackReturnDoubleArray = Array<double> ();
callback CallbackReturnEnumArray = Array<MyEnum> ();
callback CallbackReturnDictionaryArray = Array<MyDictionary> ();

// enum

enum MyEnum {
    "CASE1",
    "CASE2"
};

// dictionary

dictionary ParentDictionary {
    int a;
    int b;
};

dictionary MyDictionary: ParentDictionary {
    int c;
    int d;
};

dictionary TypeDictionary {
    char a1;
    boolean a2;
    byte a3;
    short a4;
    int a5;
    long a6;
    float a7;
    double a8;
    string a9;
    MyEnum a10;
    MyDictionary a11;
    VoidCallback a12;

    Array<char> a13;
    Array<boolean> a14;
    Array<byte> a15;
    Array<short> a16;
    Array<int> a17;
    Array<long> a18;
    Array<float> a19;
    Array<double> a20;
    Array<MyEnum> a21;
    Array<MyDictionary> a22;
};