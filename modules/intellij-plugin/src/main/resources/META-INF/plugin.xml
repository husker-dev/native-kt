<idea-plugin>
    <id>com.huskerdev.native-kt</id>
    <name>Native-Kt Utils</name>
    <vendor email="redfancoestar@gmail.com" url="https://www.huskerdev.com">husker-dev</vendor>
    <description>Syntax highlight for native-kt gradle plugin</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>org.jetbrains.plugins.gradle</depends>

    <!-- K2 mode compatibility -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true" />
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <projectService
                serviceImplementation="com.huskerdev.nativekt.intellij.NativeKtService"/>
        <postStartupActivity
                implementation="com.huskerdev.nativekt.intellij.StartupActivity"/>
        <projectViewNodeDecorator
                implementation="com.huskerdev.nativekt.intellij.NativeKtTreeDecorator"/>
        <fileType
                name="NDL File"
                implementationClass="com.huskerdev.nativekt.intellij.NdlFileType"
                fieldName="INSTANCE"
                language="NDL"
                extensions="ndl"/>
        <lang.syntaxHighlighterFactory
                implementationClass="com.huskerdev.nativekt.intellij.highlight.NdlSyntaxHighlighterFactory"
                language="NDL"/>
        <dependencySupport
                kind="kotlin"
                coordinate="com.huskerdev:native-kt-runtime"
                displayName="native-kt"/>
    </extensions>
</idea-plugin>