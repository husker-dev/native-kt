<idea-plugin>
    <id>com.huskerdev.native-kt</id>
    <name>Native-Kt Utils</name>
    <vendor email="redfancoestar@gmail.com" url="https://www.huskerdev.com">husker-dev</vendor>
    <description>Syntax highlight for native-kt gradle plugin</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>com.intellij.gradle</depends>
    <depends>com.intellij.modules.json</depends>
    <depends>org.toml.lang</depends>

    <!-- K2 mode compatibility -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true" />
    </extensions>

    <extensions defaultExtensionNs="JavaScript">
        <JsonSchema.ProviderFactory
            implementation="com.huskerdev.nativekt.intellij.NativeKtSchemaProvider"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.gradle">
        <projectResolve
            implementation="com.huskerdev.nativekt.intellij.NativeKtProjectResolver"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <dependencySupport
            kind="kotlin"
            coordinate="com.huskerdev:native-kt-runtime"
            displayName="native-kt"/>

        <fileType
            name="NDL"
            implementationClass="com.huskerdev.nativekt.intellij.ndl.NdlFileType"
            fieldName="INSTANCE"
            language="NDL"
            extensions="ndl"/>

        <!-- Tree -->

        <projectViewNodeDecorator
            implementation="com.huskerdev.nativekt.intellij.tree.NativeKtTreeDecorator"/>

        <editorFactoryDocumentListener
            implementation="com.huskerdev.nativekt.intellij.tree.NativeKtDocumentListener"/>

        <!-- Completion -->

        <completion.contributor
            language="NDL"
            implementationClass="com.huskerdev.nativekt.intellij.ndl.completion.NdlCompletionContributor"/>

        <!-- Highlight -->

        <lang.syntaxHighlighterFactory
            implementationClass="com.huskerdev.nativekt.intellij.ndl.highlight.NdlSyntaxHighlighterFactory"
            language="NDL"/>

        <externalAnnotator
            language="NDL"
            implementationClass="com.huskerdev.nativekt.intellij.ndl.highlight.NdlSyntaxErrorAnnotator"/>

        <annotator
            language="NDL"
            implementationClass="com.huskerdev.nativekt.intellij.ndl.highlight.NdlHighlightingAnnotator"/>

        <!-- Navigation -->

        <lang.findUsagesProvider
            language="NDL"
            implementationClass="com.huskerdev.nativekt.intellij.ndl.navigation.NdlFindUsagesProvider"/>

        <gotoSymbolContributor
            implementation="com.huskerdev.nativekt.intellij.ndl.navigation.NdlChooseByNameContributor"/>

        <iconProvider
            implementation="com.huskerdev.nativekt.intellij.ndl.NdlIconProvider"/>

        <usageTypeProvider
            language="NDL"
            implementation="com.huskerdev.nativekt.intellij.ndl.navigation.NdlUsageTypeProvider"/>

        <usageGroupingRuleProvider
            language="NDL"
            implementation="com.huskerdev.nativekt.intellij.ndl.navigation.NdlUsageGroupingRuleProvider"/>

        <!-- Parser -->

        <lang.parserDefinition
            implementationClass="com.huskerdev.nativekt.intellij.ndl.parser.NdlParserDefinition"
            language="NDL"/>

        <!-- PSI -->

        <lang.ast.factory
            language="NDL"
            implementationClass="com.huskerdev.nativekt.intellij.ndl.psi.NdlAstFactory"/>

        <lang.refactoringSupport
            language="NDL"
            implementationClass="com.huskerdev.nativekt.intellij.ndl.psi.NdlRefactoringSupportProvider"/>

        <lang.foldingBuilder
            implementationClass="com.huskerdev.nativekt.intellij.ndl.psi.NdlFoldingBuilder"
            language="NDL"/>

        <lang.braceMatcher
            language="NDL"
            implementationClass="com.huskerdev.nativekt.intellij.ndl.highlight.NdlBraceMatcher"/>

        <lang.psiStructureViewFactory
            language="NDL"
            implementationClass="com.huskerdev.nativekt.intellij.ndl.structure.NdlStructureViewFactory"/>

    </extensions>

    <actions>
        <group
            id="com.huskerdev.nativekt"
            class="com.huskerdev.nativekt.intellij.actions.NativeKtNewGroup"
            text="Native Module"
            popup="true"
            icon="/com/huskerdev/nativekt/intellij/icons/ocdRunConfiguration.svg">

            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewDir"/>

            <group
                id="com.huskerdev.nativekt.cmake"
                text="CMake"
                popup="true"
                icon="/com/huskerdev/nativekt/intellij/icons/CMake.svg">

                <action
                    id="com.huskerdev.nativekt.cmake.c"
                    class="com.huskerdev.nativekt.intellij.actions.NewCAction"
                    text="C"
                    icon="/com/huskerdev/nativekt/intellij/icons/c.svg"/>

                <action
                    id="com.huskerdev.nativekt.cmake.cpp"
                    class="com.huskerdev.nativekt.intellij.actions.NewCppAction"
                    text="C++"
                    icon="/com/huskerdev/nativekt/intellij/icons/cpp.svg"/>
            </group>

            <action
                id="com.huskerdev.nativekt.cargo"
                class="com.huskerdev.nativekt.intellij.actions.NewCargoAction"
                text="Rust (Cargo)"
                icon="/com/huskerdev/nativekt/intellij/icons/rustFile.svg"/>
        </group>
    </actions>
</idea-plugin>
